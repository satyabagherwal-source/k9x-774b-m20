---
import BaseLayout from '../layouts/BaseLayout.astro';

const projectName = "{{PROJECT_NAME}}";
---

<BaseLayout title={`${projectName} | Environment Ready`}>
  <div class="min-h-screen flex items-center justify-center px-4 py-12">
    <div class="max-w-2xl w-full bg-slate-900/50 border border-slate-800 rounded-3xl p-8 sm:p-10 backdrop-blur-md shadow-2xl text-center space-y-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-mono font-medium">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        ENVIRONMENT READY : CERTIFIED
      </div>
      
      <div class="space-y-2">
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight bg-gradient-to-r from-white via-slate-200 to-indigo-300 bg-clip-text text-transparent">
          {projectName}
        </h1>
        <p class="text-slate-400 text-sm max-w-md mx-auto">
          Development environment and architecture starter initialized. Ready for Phase B (Product Development).
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-left pt-6 border-t border-slate-800/80">
        <div class="bg-slate-950/40 p-3 rounded-xl border border-slate-800">
          <div class="text-xs text-slate-500">Framework</div>
          <div class="text-xs font-semibold text-slate-200 mt-1">Astro 5.x</div>
        </div>
        <div class="bg-slate-950/40 p-3 rounded-xl border border-slate-800">
          <div class="text-xs text-slate-500">Styling</div>
          <div class="text-xs font-semibold text-slate-200 mt-1">Tailwind v4</div>
        </div>
        <div class="bg-slate-950/40 p-3 rounded-xl border border-slate-800">
          <div class="text-xs text-slate-500">Brain Bridge</div>
          <div class="text-xs font-semibold text-slate-200 mt-1">Zero-Copy Active</div>
        </div>
        <div class="bg-slate-950/40 p-3 rounded-xl border border-slate-800">
          <div class="text-xs text-slate-500">Boundary</div>
          <div class="text-xs font-semibold text-emerald-400 mt-1">0 Product Code</div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
