---
interface Props {
  projectName?: string;
}

const { projectName = "AI Project" } = Astro.props;
---

<section class="relative pt-20 pb-16 px-4 sm:px-6 lg:px-8 text-center max-w-5xl mx-auto">
  <!-- Status Badge -->
  <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-medium glass-card text-indigo-300 mb-8 border border-indigo-500/20 glow-primary">
    <span class="text-indigo-400">⚡ Engine Bootstrapped</span>
    <span class="w-1 h-1 rounded-full bg-indigo-400"></span>
    <span>Astro 5 + Tailwind v4</span>
  </div>

  <!-- Primary Headline -->
  <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight font-heading leading-tight mb-6">
    Engineered for <span class="bg-gradient-to-r from-indigo-400 via-violet-300 to-teal-300 bg-clip-text text-transparent">Speed, Polish & Autonomy</span>
  </h1>

  <!-- Subheadline -->
  <p class="max-w-2xl mx-auto text-lg sm:text-xl text-slate-400 mb-10 leading-relaxed">
    Welcome to <span class="text-white font-semibold">{projectName}</span>. Built with zero-JS performance, Tailwind v4 design tokens, and synchronized with the AI-Builder-Brain engineering intelligence.
  </p>

  <!-- CTA Buttons -->
  <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
    <a href="#features" class="w-full sm:w-auto inline-flex items-center justify-center px-7 py-3.5 rounded-xl font-semibold text-white bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 shadow-lg shadow-indigo-600/30 transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0">
      Explore Architecture →
    </a>
    <a href="#status" class="w-full sm:w-auto inline-flex items-center justify-center px-7 py-3.5 rounded-xl font-semibold text-slate-200 glass-card hover:bg-slate-800/80 transition-all duration-200 border border-slate-700/60">
      View Certification Report
    </a>
  </div>

  <!-- Feature Grid -->
  <div id="features" class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-20 text-left">
    <div class="glass-card p-6 rounded-2xl hover:border-indigo-500/40 transition-all duration-300">
      <div class="w-10 h-10 rounded-xl bg-indigo-500/10 text-indigo-400 flex items-center justify-center text-xl mb-4 border border-indigo-500/20">
        🧠
      </div>
      <h3 class="font-heading font-semibold text-lg text-white mb-2">Brain Bridge Connected</h3>
      <p class="text-sm text-slate-400 leading-relaxed">
        Zero-copy connection to Master AI-Builder-Brain. Reusable patterns loaded selectively without bloating the repository.
      </p>
    </div>

    <div class="glass-card p-6 rounded-2xl hover:border-teal-500/40 transition-all duration-300">
      <div class="w-10 h-10 rounded-xl bg-teal-500/10 text-teal-400 flex items-center justify-center text-xl mb-4 border border-teal-500/20">
        🎨
      </div>
      <h3 class="font-heading font-semibold text-lg text-white mb-2">Tailwind CSS v4</h3>
      <p class="text-sm text-slate-400 leading-relaxed">
        Powered by CSS-first <code class="text-xs bg-slate-800 px-1 py-0.5 rounded text-teal-300">@theme</code> tokens and <code class="text-xs bg-slate-800 px-1 py-0.5 rounded text-teal-300">@tailwindcss/vite</code> for sub-second hot module reloads.
      </p>
    </div>

    <div class="glass-card p-6 rounded-2xl hover:border-violet-500/40 transition-all duration-300">
      <div class="w-10 h-10 rounded-xl bg-violet-500/10 text-violet-400 flex items-center justify-center text-xl mb-4 border border-violet-500/20">
        🛡️
      </div>
      <h3 class="font-heading font-semibold text-lg text-white mb-2">Evidence-Based Learning</h3>
      <p class="text-sm text-slate-400 leading-relaxed">
        Autonomous incident capture with non-destructive invariant testing. Only verified engineering outcomes are promoted.
      </p>
    </div>
  </div>
</section>
