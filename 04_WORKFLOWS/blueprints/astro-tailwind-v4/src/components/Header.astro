---
interface Props {
  projectName?: string;
}

const { projectName = "AI Project" } = Astro.props;
---

<header class="sticky top-0 z-50 w-full glass-panel border-b border-slate-800/80">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-indigo-500 to-violet-600 flex items-center justify-center font-bold text-white shadow-md shadow-indigo-500/20">
        ⚡
      </div>
      <span class="font-heading font-bold text-lg tracking-tight bg-gradient-to-r from-white via-slate-200 to-slate-400 bg-clip-text text-transparent">
        {projectName}
      </span>
    </div>

    <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-300">
      <a href="#features" class="hover:text-white transition-colors duration-150">Features</a>
      <a href="#architecture" class="hover:text-white transition-colors duration-150">Architecture</a>
      <a href="#status" class="hover:text-white transition-colors duration-150">Status</a>
    </nav>

    <div class="flex items-center gap-3">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        PROJECT READY
      </span>
    </div>
  </div>
</header>
