# AI-Builder-Brain Git Ignore Rules

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# IDE / editor local settings
.vscode/
.idea/
*.swp
*.swo

# Environment and secret files
.env
.env.*
!.env.example

# Private keys / certificates / credentials
*.pem
*.key
*.p12
*.pfx
*.crt

# Temporary and backup files
*.tmp
*.temp
*.bak
*.backup
*~

# Local logs
*.log

# Batch Harvester Temporary Clone Sandbox
.temp-harvest/
*.shallow-clone/

# Multi-Agent Concurrency Locks
.harvest-locks/


