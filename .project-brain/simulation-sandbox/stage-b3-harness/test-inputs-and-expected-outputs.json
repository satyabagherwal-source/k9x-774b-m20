          "tolerance": 1e-6
        },
        {
          "case_id": "CMTP-CASE-02",
          "description": "Extreme boundary condition: All tokens masked (zero attention mask sum)",
          "inputs": {
            "token_embeddings_shape": [1, 2, 2],
            "tokens": [
              [[10.0, 20.0], [30.0, 40.0]]
            ],
            "attention_mask": [
              [0, 0]
            ]
          },
          "expected_outputs": [
            [0.0, 0.0]
