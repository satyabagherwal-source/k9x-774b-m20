          "assertions": [
            "No NaN in output tensor",
            "No Inf in output tensor",
            "Divisor clamped to min 1e-9"
          ]
        },
        {
          "case_id": "CMTP-CASE-03",
          "description": "Single-token unpadded sequence",
          "inputs": {
            "token_embeddings_shape": [1, 1, 2],
            "tokens": [
              [[42.0, -17.5]]
            ],
            "attention_mask": [
              [1]
            ]
          },
          "expected_outputs": [
            [42.0, -17.5]
          ],
          "tolerance": 1e-6
        }
      ]
